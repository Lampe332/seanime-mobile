# patch-package compares bytes: a CRLF checkout would no longer apply to the LF files in node_modules.
/native/patches/*.patch -text
# Bash stops at a CR: shell scripts stay LF on every checkout.
*.sh text eol=lf
# Third-party source is kept byte for byte as released.
/native/modules/core-sandbox/cpp/third_party/** -text
# GitHub's language bar should count the code written for this app, not generated files:
# Seanime's API types (made by its codegen) and the two bundles built by native/scripts/.
/native/src/api/generated/*.types.ts linguist-generated
/native/src/api/generated/endpoints.ts linguist-generated
/native/src/api/generated/types.ts linguist-generated
*.generated.ts linguist-generated
# The two bundles are compared byte for byte with a fresh build (helpers.test.ts, manage.test.ts): a CRLF checkout
# (core.autocrlf on Windows) made both tests fail, so they stay LF on every checkout.
*.generated.ts text eol=lf
