{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["seanime", "coretorrent"],
  "ios": {
    "iosModuleName": "SeanimeCoreTorrent"
  },
  "android": {
    "androidNamespace": ["seanime", "coretorrent"],
    "androidCxxLibName": "SeanimeCoreTorrent"
  },
  "autolinking": {
    "CoreTorrent": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridCoreTorrent"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": false
}
