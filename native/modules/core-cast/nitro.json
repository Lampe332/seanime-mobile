{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["seanime", "corecast"],
  "ios": {
    "iosModuleName": "SeanimeCoreCast"
  },
  "android": {
    "androidNamespace": ["seanime", "corecast"],
    "androidCxxLibName": "SeanimeCoreCast"
  },
  "autolinking": {
    "CoreCast": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridCoreCast"
      }
    },
    "CoreCastLock": {
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridCoreCastLock"
      }
    }
  },
  "ignorePaths": ["**/node_modules"],
  "gitAttributesGeneratedFlag": false
}
