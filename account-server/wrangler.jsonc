{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seanime-account",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  // N-6: no invocation logs (they hold request data) and no traces. Only the Worker's own console lines are kept:
  // route and error type, never an IP, email, token or body.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://seanimemobile.com",
    // Base URL for links in emails (verify, reset).
    "WEB_BASE_URL": "https://seanimemobile.com",
    // Google signing keys. Only a test host (*.test, localhost) can replace Google's URL (src/google.ts jwksUrl).
    "GOOGLE_JWKS_URL": "https://www.googleapis.com/oauth2/v3/certs"
  },
  // Values are set with `wrangler secret put`, never committed. GOOGLE_WEB_CLIENT_ID is optional: without it every
  // Google sign-in is refused (src/google.ts), which is how 4.2.0 ships (Google sign-in is hidden in the app).
  "secrets": {
    "required": ["PEPPER_V1", "ENUM_SECRET"]
  },
  // Reached only through its own domain; no workers.dev or preview URLs.
  "routes": [{ "pattern": "api.seanimemobile.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seanime-account",
      "database_id": "78a6f6d2-113d-476b-97f9-14cd58bc0c91",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Service. The sender domain must be onboarded before the first deploy.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["no-reply@seanimemobile.com"] }
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "seanime-account-snapshots"
    }
  ],
  // Short burst limits per IP. Longer windows (15 min, 1 h) are counted in D1.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGNUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  }
}
